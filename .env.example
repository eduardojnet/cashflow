# Modelo das variáveis do ambiente local (001-T6; INFRA 5.9, 5.10).
#
# Copie para infra/.env, que o Docker Compose lê e o Git ignora, e preencha
# cada valor com um segredo próprio:
#
#   cp .env.example infra/.env
#   chmod 600 infra/.env
#
# Nenhum valor real neste arquivo. Os valores vazios são intencionais: o
# compose recusa subir enquanto uma variável obrigatória estiver vazia. Para
# gerar cada segredo, use hexadecimal, que não exige escape em URL nem em
# string de conexão:
#
#   openssl rand -hex 24
#
# As senhas dos papéis PostgreSQL são gravadas só na criação do volume. Para
# trocá-las depois, reaplique o script do banco (ver infra/postgres/*/10-papeis.sh).

# PostgreSQL do livro: superusuário da instância e papéis (design 001 §4).
PG_LIVRO_SENHA_SUPERUSUARIO=
PG_LIVRO_SENHA_MIGRACAO=
PG_LIVRO_SENHA_API=
PG_LIVRO_SENHA_RELAY=
PG_LIVRO_SENHA_REPLAY=

# PostgreSQL do consolidado: superusuário da instância e papéis (design 001 §4).
PG_CONSOLIDADO_SENHA_SUPERUSUARIO=
PG_CONSOLIDADO_SENHA_MIGRACAO=
PG_CONSOLIDADO_SENHA_WORKER=
PG_CONSOLIDADO_SENHA_API=
PG_CONSOLIDADO_SENHA_OPERACAO=

# RabbitMQ: usuários de permissão mínima (001-T2).
RABBITMQ_SENHA_RELAY=
RABBITMQ_SENHA_WORKER=

# Keycloak: administrador do realm master e segredos dos clientes técnicos
# do realm cashflow (001-T4).
KEYCLOAK_SENHA_ADMIN=
KEYCLOAK_SEGREDO_CLIENTE_LANCAMENTOS=
KEYCLOAK_SEGREDO_CLIENTE_CONSULTAS=

# Opcional: porta do host para o Keycloak em 127.0.0.1 (padrão 8443).
# KEYCLOAK_PORTA_HOST=8443

# Opcional: porta do host para a API de lançamentos em 127.0.0.1 (padrão 8444).
# LANCAMENTOS_API_PORTA_HOST=8444

# Opcional: porta do host para a API do consolidado em 127.0.0.1 (padrão 8445).
# CONSOLIDADO_API_PORTA_HOST=8445
