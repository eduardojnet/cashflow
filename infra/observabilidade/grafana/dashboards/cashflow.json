    {
      "type": "stat",
      "id": 29,
      "title": "Alertas disparados",
      "description": "Regras de FR-006 avaliadas pelo Prometheus (infra/observabilidade/regras.yml; design 007 TD-004): 0 = normal; 1 ou mais = alerta disparado (instâncias em firing). Detalhes na página de alertas do Grafana.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-cashflow"
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-cashflow"
          },
          "expr": "count(ALERTS{alertname=\"CashFlowOutboxEventoAntigo\", alertstate=\"firing\"}) or vector(0)",
          "legendFormat": "Evento antigo na outbox",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-cashflow"
          },
          "expr": "count(ALERTS{alertname=\"CashFlowQuarentena\", alertstate=\"firing\"}) or vector(0)",
          "legendFormat": "Quarentena",
          "refId": "B",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-cashflow"
          },
          "expr": "count(ALERTS{alertname=\"CashFlowLacunas\", alertstate=\"firing\"}) or vector(0)",
          "legendFormat": "Lacunas",
          "refId": "C",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "normal",
                  "color": "green",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
